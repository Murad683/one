generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  name         String
  role         Role          @default(CLIENT)
  isActive     Boolean       @default(true)
  packageId    String?
  igUsername    String?
  igBio        String?
  igFollowers  String?
  igFollowing  String?
  igPostsCount String?
  igProfilePic String?
  igHighlights Json          @default("[]")
  shareToken           String?   @unique
  shareTokenExpiresAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  package      Package?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  deliverables Deliverable[]
  payments     Payment[]
  tickets      Ticket[]
  refreshTokens RefreshToken[]
  highlights   Highlight[]
  createdDeliverables Deliverable[] @relation("DeliverableCreatedBy")
  // Retention notice mails (services/notice.service.ts)
  emailBouncedAt    DateTime?   // the address bounced or complained: no more mail until it is changed
  infoMailSentTo    String?     // address the "notices will come here" mail went to
  lastNoticeMailAt  DateTime?   // at most one mail per client per Baku day
}

model Project {
  id             String    @id @default(cuid())
  thumbnailUrl   String?
  youtubeId      String?
  categoryLegacy String?
  isPublished    Boolean   @default(false)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  isFeatured     Boolean   @default(false)
  categoryId     String?
  externalUrl    String?
  year           Int?

  videoUrl          String?
  videoThumbnailUrl String?
  videoStatus       String?

  description    String
  title          String
  category       Category? @relation(fields: [categoryId], references: [id])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Package {
  id          String   @id @default(cuid())
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  priceLabel  String
  buttonText  String   @default("Planı Seç")
  buttonUrl   String   @default("/contact")
  youtubeUrl  String?

  videoUrl          String?
  videoThumbnailUrl String?
  videoStatus       String?

  description String
  features    String[]
  name        String
  users       User[]
}

model Service {
  id          String   @id @default(cuid())
  iconName    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String
  title       String
}

model TeamMember {
  id          String   @id @default(cuid())
  avatarUrl   String?
  linkedinUrl String?
  twitterUrl  String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  role        String
}

model Deliverable {
  id             String            @id @default(cuid())
  clientId       String
  type           String?
  status         DeliverableStatus @default(PENDING)
  title          String            @default("Başlıksız")
  month          Int
  year           Int
  files          Json              @default("[]")
  notes          String?
  clientFeedback String?           @db.Text
  uploadedAt     DateTime?
  thumbnailUrl   String?
  processingDuration Int?
  width          Int?
  height         Int?
  originalUrl    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  client         User                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category       DeliverableCategory? @relation(fields: [categoryId], references: [id])
  categoryId     String?
  createdById    String?
  createdBy      User?                @relation("DeliverableCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  // Video retention (utils/retention.ts): null = the rule does not apply yet.
  firstReadyAt   DateTime?
  expiresAt      DateTime?
  hiddenAt       DateTime?
  mediaDeletedAt DateTime?
  notice7SentAt  DateTime?  // the warning mail covering this video went out (was the 7-day flag; there is a single warning now)
  notice1SentAt  DateTime?  // unused since the single warning (kept: columns are never dropped on deploy)

  uploads        DeliverableUpload[]

  @@index([clientId, year, month])
  @@index([createdById])
  @@index([expiresAt])
  @@index([hiddenAt])
}

// One browser upload of a file for a deliverable (utils/deliverableUploads.ts). The browser writes
// "started / progress / assembled" through the API, so the server knows an upload was cut off and
// the admin list can say so. status: UPLOADING -> ASSEMBLED (whole object in storage, finalize not
// called) -> FINALIZED (processing started); ABORTED (user/error); EXPIRED (the job gave up).
model DeliverableUpload {
  id             String      @id @default(cuid())
  deliverableId  String
  deliverable    Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  createdById    String?
  kind           String
  storageKey     String      @unique
  uploadId       String?
  fileName       String
  fileSize       BigInt
  mimeType       String
  status         String      @default("UPLOADING")
  progress       Int         @default(0)
  lastActivityAt DateTime    @default(now())
  createdAt      DateTime    @default(now())
  endedAt        DateTime?
  reason         String?

  @@index([deliverableId])
  @@index([status, lastActivityAt])
}

model DeliverableCategory {
  id           String        @id @default(cuid())
  name         String        @unique
  isVideo      Boolean       @default(false)
  deliverables Deliverable[]
  createdAt    DateTime      @default(now())
}

model SiteSettings {
  id                   String   @id @default("global")
  aboutStats           String   @default("[]")
  heroCtaText          String   @default("Bizimlə Əlaqə")
  heroCtaUrl           String   @default("/contact")
  heroVideoUrl         String?
  // Tiny data-URI first frame of heroVideoUrl, written by the server on upload (never by PATCH /site-settings).
  heroPoster           String?
  marqueeWords         String   @default("[]")
  companyAddress       String   @default("")
  companyPhone         String   @default("")
  companyEmail         String   @default("")
  companyWorkingHours  String   @default("")
  googleMapsEmbed      String?
  socialLinks          String   @default("{}")
  updatedAt            DateTime @updatedAt
  aboutDescription     String   @default("")
  aboutMainHeading     String   @default("Brendləri Quranlara Tərəfdaşıq")
  aboutQuote           String   @default("")
  aboutTeamBadge       String   @default("KOMANDAMIZ")
  aboutTeamTitle       String   @default("Kreativ Zehinlər")
  aboutTopLabel        String   @default("BİZ KİMİK")
  contactAddressLabel  String   @default("ÜNVAN")
  contactEmailLabel    String   @default("E-POÇT")
  contactHoursLabel    String   @default("İŞ SAATLARI")
  contactInfoTitle     String   @default("Məlumatlarımız")
  contactMainHeading   String   @default("Bizimlə Əlaqə")
  contactPhoneLabel    String   @default("TELEFON")
  contactSubtext       String   @default("")
  contactTopLabel      String   @default("ƏLAQƏ")
  footerPagesTitle     String   @default("SƏHİFƏLƏR")
  footerShortText      String   @default("")
  footerSocialTitle    String   @default("SOSİAL MEDİA")
  heroBadge            String   @default("Rəqəmsal İnkişaf Şirkəti")
  heroHeading1         String   @default("")
  heroHeading2         String   @default("")
  heroSubtext          String   @default("")
  packagesMainHeading  String   @default("Sizin üçün doğru plan")
  packagesSubtext      String   @default("")
  packagesTopLabel     String   @default("QİYMƏT PAKETLƏRİ")
  portfolioMainHeading String   @default("")
  portfolioTopLabel    String   @default("PORTFOLİO")
  navbarLogoUrl        String?
  footerLogoUrl        String?
}

model ContactSubmission {
  id          String   @id @default(cuid())
  name        String
  email       String
  companyName String?
  serviceId   String?
  serviceName String?
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model SiteContent {
  id        String   @id
  key       String   @unique
  value     String
  page      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id              Int      @id @default(autoincrement())
  amount          Decimal
  currency        String   @default("AZN")
  paidAt          DateTime
  nextPaymentDate DateTime
  invoicePdfUrl   String?
  note            String?
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Ticket {
  id        Int          @id @default(autoincrement())
  subject   String
  body      String       @db.Text
  status    TicketStatus @default(OPEN)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hiddenByAdminAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CLIENT
  CREATOR
}

enum DeliverableStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}



enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Instagram-style highlights: a circle (cover + title) that opens a story viewer.
// User.igHighlights (JSON) is the older one-image form; it is never dropped and is
// copied into these tables the first time staff edit a client's highlights.
model Highlight {
  id          String          @id @default(cuid())
  userId      String
  title       String
  // The item shown on the circle; null = the first item.
  coverItemId String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       HighlightItem[]

  @@index([userId, sortOrder])
}

model HighlightItem {
  id          String    @id @default(cuid())
  highlightId String
  // Storage key of the (optimized) image.
  imageUrl    String
  // Untouched original for downloads; null for images stored before originals were kept.
  originalUrl String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  highlight   Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)

  @@index([highlightId, sortOrder])
}

// Images staged by the highlight editor before "Yadda saxla". Not linked to any highlight, so
// no client sees them; saving moves them into HighlightItem, cancelling or the hourly job deletes them.
model HighlightUpload {
  id           String   @id @default(cuid())
  key          String   @unique
  // The untouched original next to the optimized copy (`key`); null when no separate copy was made.
  originalKey  String?
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([uploadedById])
  @@index([createdAt])
}
