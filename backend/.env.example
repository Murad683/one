DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=
PORT=
NODE_ENV=
FRONTEND_URL=
ADMIN_URL=
CORS_ORIGIN=
UPLOAD_DEST=
MAX_FILE_SIZE_MB=

STORAGE_PROVIDER=local        # Options: local | azure | s3
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=bakutech-deliverables

# S3-compatible storage (Hetzner Object Storage, AWS S3, MinIO, ...)
S3_ENDPOINT=                  # e.g. https://nbg1.your-objectstorage.com (Hetzner)
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true      # set to "false" only for AWS S3 itself

# Validity of signed media read/download URLs, in seconds.
# Default 86400 (1 day); clamped to [60, 604800] (7 days = SigV4 max).
PRESIGNED_URL_TTL_SECONDS=86400

# Public site media (portfolio, packages, team, site settings) through the API so a
# CDN (Cloudflare) can cache it. Needs STORAGE_PROVIDER=s3. Off by default.
PUBLIC_MEDIA_PROXY=off        # on | off
PUBLIC_API_URL=               # default https://api.ourneweye.com
PUBLIC_MEDIA_RANGE=on         # "off" answers every request with the whole file (no partial 206 answers)

# Seed Credentials
SUPER_ADMIN_EMAIL=fake@example.com
SUPER_ADMIN_PASSWORD=FakePassword123!

# Admin panel help assistant (Google Gemini). Leave GEMINI_API_KEY empty to disable it.
GEMINI_API_KEY=
# Optional. Defaults to the "gemini-flash-latest" alias.
GEMINI_MODEL=
# Optional. Model tried last when GEMINI_MODEL keeps failing (defaults to gemini-flash-lite-latest).
GEMINI_FALLBACK_MODEL=
